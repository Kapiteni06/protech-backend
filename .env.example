PORT=4000
# Required. Use a random string of at least 32 characters, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production (NODE_ENV=production or on Render) without it.
JWT_SECRET=
# Comma-separated list of websites allowed to call the API (your frontend URL).
# Leave empty to allow any website (a warning is printed).
CORS_ORIGINS=
# Super admins (comma-separated emails): full access AND can add/change/remove admins in the admin panel.
# Put your own email here so you can never be locked out.
SUPER_ADMIN_EMAILS=
# Full admins (comma-separated emails, optional). Admins can also be added from the admin panel's Team tab.
ADMIN_EMAILS=
# Google Sign-In (optional)
GOOGLE_CLIENT_ID=
# ---------- Database (MySQL) ----------
# Leave empty to keep data in backend/data on this computer.
# On Render you MUST set it, because Render's free plan wipes local files on every restart.
# Paste the "Service URI" from Aiven (or any MySQL host): mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
MYSQL_URL=
# The CA certificate of your MySQL server (Aiven: "CA certificate" on the service page). Paste the whole text,
# including the BEGIN/END lines. Or put it in a file and set MYSQL_SSL_CA_FILE to its path instead.
MYSQL_SSL_CA=
MYSQL_SSL_CA_FILE=
# Only for a MySQL server on your own computer without SSL: MYSQL_SSL=false
MYSQL_SSL=

# ---------- Emails (SMTP) ----------
# Welcome emails, password reset links, order confirmations and order status updates.
# Render's free plan blocks ports 25, 465 and 587, so use Brevo on port 2525:
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=2525  SMTP_USER=<Brevo SMTP login>  SMTP_PASS=<Brevo SMTP key>
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Must be a sender address you verified in Brevo, e.g.  ProTech <yourname@gmail.com>
EMAIL_FROM=
# Your website, used for the links inside emails
FRONTEND_URL=https://protech.free.je
# Optional: also email every new order to this address (e.g. your own)
ORDER_NOTIFY_EMAIL=
# Local testing only: return the reset token in the API response when SMTP is not set up.
# Ignored in production. Never enable this on a live site.
ALLOW_DEV_RESET_TOKEN=false
